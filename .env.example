CUDA_VISIBLE_DEVICES=0
MODEL_DIR=/app/checkpoints
LRU_SIZE=8

# fake | sam2
PREDICTOR_BACKEND=fake

# tiny pour démarrer rapidement (149 MB, 4 GB VRAM). base_plus ou large pour
# une meilleure qualité (cf. ./scripts/download_checkpoints.sh).
DEFAULT_MODEL=sam2_hiera_tiny

# 1 pour build l'image avec sam2 installé (compile CUDA, ~2-5 min). 0 pour
# dev rapide en mode fake.
INSTALL_SAM2=0

BACKEND_PORT=8000
FRONTEND_PORT=5173
